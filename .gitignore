# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
!gradle/wrapper/gradle-wrapper.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# Gradle / Kotlin build output
.gradle/
.kotlin/
**/build/
!src/**/build/
# Keep the production web build so it can be committed / served (e.g. GitHub Pages).
# A path can't be un-ignored while a parent dir is ignored, so open each level explicitly.
!composeApp/build/
composeApp/build/*
!composeApp/build/dist/
composeApp/build/dist/*
!composeApp/build/dist/wasmJs/
composeApp/build/dist/wasmJs/*
!composeApp/build/dist/wasmJs/productionExecutable/
captures/
.externalNativeBuild/
.cxx/

# Local config
local.properties

# IDE
.idea/
*.iml
.DS_Store

# Xcode
xcuserdata/
*.xcodeproj/*
!*.xcodeproj/project.pbxproj
!*.xcodeproj/xcshareddata/
!*.xcodeproj/project.xcworkspace/
!*.xcworkspace/contents.xcworkspacedata
**/xcshareddata/WorkspaceSettings.xcsettings
